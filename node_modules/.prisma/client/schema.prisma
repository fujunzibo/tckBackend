generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  nickname       String   @db.VarChar(64)
  walletAddress  String?  @unique
  invitationCode String   @unique
  inviterId      String?
  status         String   @default("normal")
  points         Decimal  @default(0) @db.Decimal(78, 0)
  level          String   @default("Bronze")
  platformMode   String   @default("demo")
  dataSource     String   @default("native")
  actorType      String   @default("player")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([inviterId])
  @@index([points(sort: Desc), id])
  @@index([createdAt(sort: Desc), id])
}

model Identity {
  id        String   @id @default(uuid())
  userId    String
  provider  String
  subject   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, subject])
  @@index([userId])
}

model AuthSession {
  id        String    @id @default(uuid())
  subjectId String
  domain    String
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([subjectId, domain])
  @@index([expiresAt])
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String
  entryIds     String[] @default([])
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @db.Timestamptz(3)
}

model Invitation {
  id          String    @id @default(uuid())
  inviterId   String
  inviteeId   String    @unique
  effectiveAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([inviterId, createdAt])
}

model Asset {
  id           String @id
  symbol       String
  decimals     Int    @default(0)
  chainId      String @default("demo-ledger")
  platformMode String @default("demo")
}

model Account {
  id      String  @id
  userId  String?
  assetId String
  kind    String
  balance Decimal @default(0) @db.Decimal(78, 0)

  @@index([userId, assetId])
}

model LedgerTransaction {
  id          String   @id @default(uuid())
  businessKey String   @unique
  reason      String
  referenceId String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

model LedgerEntry {
  id            String   @id @default(uuid())
  transactionId String
  accountId     String
  userId        String?
  assetId       String
  amount        Decimal  @db.Decimal(78, 0)
  reason        String
  businessId    String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([transactionId, accountId])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([accountId])
}

model TicketLot {
  id          String    @id @default(uuid())
  userId      String
  businessKey String    @unique
  remaining   Int
  locked      Int       @default(0)
  purpose     String    @default("fighter")
  expiresAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
}

model TicketUse {
  id          String   @id @default(uuid())
  lotId       String
  userId      String
  businessKey String   @unique
  status      String   @default("locked")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

model Game {
  id          String  @id
  slug        String  @unique
  name        String
  description Json
  kind        String
  chainId     String
  assetId     String
  entryId     String
  mode        String  @default("demo")
  status      String
  color       String
  costAtomic  Decimal @db.Decimal(78, 0)
  version     Int     @default(1)

  @@index([status, kind])
}

model GameRule {
  id            String   @id @default(uuid())
  gameId        String
  version       Int
  amountAtomic  Decimal  @db.Decimal(78, 0)
  multiplier    Int      @default(2)
  engineVersion String   @default("coin-flip-demo-v1")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([gameId, version])
}

model GameQuote {
  id           String   @id @default(uuid())
  userId       String
  gameId       String
  choice       String
  assetId      String
  amountAtomic Decimal  @db.Decimal(78, 0)
  ruleVersion  Int
  expiresAt    DateTime @db.Timestamptz(3)
  consumedBy   String?  @unique
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
}

model GameSession {
  id            String    @id @default(uuid())
  userId        String
  gameId        String
  quoteId       String    @unique
  choice        String
  outcome       String
  randomSeed    String
  resultHash    String
  engineVersion String    @default("coin-flip-demo-v1")
  ruleVersion   Int
  status        String    @default("playing")
  amountAtomic  Decimal   @db.Decimal(78, 0)
  payoutAtomic  Decimal   @db.Decimal(78, 0)
  assetId       String
  readyAt       DateTime  @db.Timestamptz(3)
  settledAt     DateTime? @db.Timestamptz(3)
  version       Int       @default(1)
  platformMode  String    @default("demo")
  dataSource    String    @default("native")
  actorType     String    @default("player")
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
}

model Fighter {
  id              String   @id @default(uuid())
  userId          String
  name            String
  style           String
  status          String   @default("generating")
  power           Int
  speed           Int
  defense         Int
  attempt         Int      @default(1)
  simulateFailure Boolean  @default(false)
  refunded        Boolean  @default(false)
  readyAt         DateTime @db.Timestamptz(3)
  version         Int      @default(1)
  platformMode    String   @default("demo")
  dataSource      String   @default("native")
  actorType       String   @default("player")
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, status])
}

model Fight {
  id           String    @id @default(uuid())
  userId       String
  fighterId    String
  opponent     String    @default("NOVA · Training bot")
  status       String    @default("queued")
  won          Boolean
  randomSeed   String
  resultHash   String
  readyAt      DateTime  @db.Timestamptz(3)
  settledAt    DateTime? @db.Timestamptz(3)
  version      Int       @default(1)
  platformMode String    @default("demo")
  dataSource   String    @default("native")
  actorType    String    @default("player")
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
}

model Quest {
  id           String   @id @default(uuid())
  title        Json
  description  Json
  type         String
  rewardAmount Decimal  @db.Decimal(78, 0)
  reviewMode   String
  status       String
  entryId      String   @default("tck-originals")
  startTime    DateTime @db.Timestamptz(3)
  endTime      DateTime @db.Timestamptz(3)
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([status, type])
}

model QuestRecord {
  id           String   @id @default(uuid())
  userId       String
  questId      String
  periodKey    String
  status       String
  proof        String
  rejectReason String?
  rewardAmount Decimal  @db.Decimal(78, 0)
  questVersion Int
  version      Int      @default(1)
  submittedAt  DateTime @default(now()) @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, questId, periodKey])
  @@index([status, submittedAt])
}

model QuestSubmission {
  id          String    @id @default(uuid())
  recordId    String
  version     Int
  proof       String
  reason      String?
  action      String?
  reviewerId  String?
  submittedAt DateTime  @default(now()) @db.Timestamptz(3)
  reviewedAt  DateTime? @db.Timestamptz(3)

  @@unique([recordId, version])
}

model Reward {
  id           String    @id @default(uuid())
  userId       String
  questId      String
  recordId     String    @unique
  title        Json
  amountAtomic Decimal   @db.Decimal(78, 0)
  assetId      String    @default("POINTS")
  status       String    @default("eligible")
  issuedAt     DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, status, createdAt(sort: Desc)])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  eventKey  String    @unique
  type      String
  title     Json
  body      Json
  href      String
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
}

model LiveWin {
  id           String   @id @default(uuid())
  sessionId    String   @unique
  gameId       String
  payoutAtomic Decimal  @db.Decimal(78, 0)
  assetId      String
  nickname     String
  source       String   @default("demo")
  actorType    String   @default("player")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model Setting {
  id             String  @id @default("global")
  version        Int     @default(1)
  maintenance    Boolean @default(false)
  gameCostAtomic Decimal @default(25) @db.Decimal(78, 0)
  maxFighters    Int     @default(3)
}

model ConfigVersion {
  id        String   @id @default(uuid())
  version   Int      @unique
  actorId   String
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  target    String
  reason    String
  requestId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model Idempotency {
  id        String   @id @default(uuid())
  subject   String
  operation String
  key       String
  hash      String
  response  Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([subject, operation, key])
}

model Job {
  id          String    @id @default(uuid())
  businessKey String    @unique
  type        String
  entityId    String
  userId      String
  attempt     Int       @default(0)
  status      String    @default("pending")
  runAt       DateTime  @db.Timestamptz(3)
  leaseUntil  DateTime? @db.Timestamptz(3)
  leaseOwner  String?
  lastError   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, runAt])
}

model Outbox {
  id            String    @id @default(uuid())
  eventKey      String    @unique
  type          String
  userId        String
  entityId      String
  entityVersion Int
  payload       Json
  publishedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([publishedAt, createdAt])
}

model WorkerHeartbeat {
  id String   @id
  at DateTime @db.Timestamptz(3)
}

model HoldingSnapshot {
  id        String   @id @default(uuid())
  userId    String
  chainId   String   @default("demo-ledger")
  balance   Decimal  @default(0) @db.Decimal(78, 0)
  source    String   @default("demo")
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc)])
}

model ImportBatch {
  id        String   @id @default(uuid())
  source    String
  checksum  String   @unique
  status    String
  rowCount  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model LegacyIdentityLink {
  id           String   @id @default(uuid())
  sourceSystem String
  sourceId     String
  userId       String?
  status       String   @default("unverified")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([sourceSystem, sourceId])
}
